NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simpatik
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=
TRUSTED_ORIGINS=http://localhost:3000
# Storage: local (default outside production) or s3. Set driver and bucket explicitly in production.
STORAGE_DRIVER=local
# Local root directory when STORAGE_DRIVER=local; production requires an absolute path.
# S3 bucket name when STORAGE_DRIVER=s3: 3-63 lowercase letters, numbers, dots, or hyphens;
# start/end alphanumeric; no adjacent dots, dot-hyphen pairs, IPv4 names, URLs, or paths.
STORAGE_BUCKET=./storage
S3_REGION=
# Optional custom root endpoint, for example http://localhost:9000; production requires HTTPS.
# S3_* settings are only read and validated when STORAGE_DRIVER=s3.
S3_ENDPOINT=
# Optional literal true/false. Defaults true with S3_ENDPOINT, otherwise false.
S3_FORCE_PATH_STYLE=
# Optional object-key prefix. Surrounding slashes are trimmed.
S3_KEY_PREFIX=
# AWS credentials use the standard AWS SDK provider-chain environment variables.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
MAX_UPLOAD_SIZE=10485760
SEED_PASSWORD=
NEXT_PUBLIC_API_URL=http://localhost:4000
